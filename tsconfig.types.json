{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declarationMap": false,
		"declarationDir": "./dist/types",
		"outDir": "./dist/types",
		"rootDir": "src"
	},
	"include": ["src/index.ts", "src/paths.ts", "src/generator/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
