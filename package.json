{
	"author": "Marius Modlich <m.modlich@digitalkitchen.io>",
	"bugs": {
		"url": "https://github.com/dgtlkitchen/pioneer/issues"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"exports": {
		".": { "types": "./dist/types/index.d.ts", "import": "./dist/index.js" }
	},
	"dependencies": {
		"@bufbuild/buf": "1.74.0",
		"@bufbuild/protobuf": "2.16.0",
		"@bufbuild/protoc-gen-es": "2.16.0",
		"@connectrpc/connect": "2.2.0",
		"@connectrpc/connect-node": "2.2.0",
		"@connectrpc/connect-web": "2.2.0",
		"@noble/curves": "2.4.0",
		"@noble/hashes": "2.4.0",
		"@scure/base": "2.4.0",
		"@scure/bip32": "2.4.0",
		"@scure/bip39": "2.4.0",
		"@tanstack/react-query": "5.104.3",
		"@types/react": "19.3.0",
		"react": "19.3.1",
		"rolldown": "1.2.14",
		"typescript": "6.0.3"
	},
	"description": "CLI generating typed npm SDK packages from Buf protobuf sources",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@types/bun": "1.4.3",
		"@types/node": "26.6.5",
		"commitizen": "4.3.2",
		"cz-conventional-changelog": "3.3.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"rimraf": "6.1.3"
	},
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist",
		"src/runtime",
		"npm-shrinkwrap.json"
	],
	"homepage": "https://github.com/dgtlkitchen/pioneer#readme",
	"keywords": [],
	"license": "Apache-2.0",
	"name": "@vastward/pioneer",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dgtlkitchen/pioneer.git"
	},
	"scripts": {
		"clean": "rimraf dist",
		"generate": "bun --no-env-file --no-install ./scripts/gen.ts",
		"build": "rolldown -c rolldown.config.ts && tsc -p tsconfig.types.json",
		"test:unit": "bun --no-env-file --no-install test tests/unit",
		"test:watch": "bun --no-env-file --no-install test --watch tests/unit",
		"test:coverage": "bun --no-env-file --no-install test --coverage tests/unit",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"lint:unsafe": "biome check --fix --unsafe",
		"typecheck": "tsc --noEmit",
		"test": "bun --no-env-file --no-install test tests/unit"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@bufbuild/buf"
	],
	"version": "0.0.1",
	"type": "module",
	"bin": { "pioneer": "./dist/cli.js" },
	"engines": {
		"node": ">=20.19.0",
		"bun": ">=1.3.0"
	}
}
