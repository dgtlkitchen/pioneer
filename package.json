{
	"author": "Marius Modlich <m.modlich@digitalkitchen.io>",
	"bugs": {
		"url": "https://github.com/vexxvakan/pioneer/issues"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"exports": {
		"./cosmos/*": {
			"types": "./dist/types/cosmos/*.d.ts",
			"import": "./dist/esm/cosmos/*.js",
			"require": "./dist/cjs/cosmos/*.cjs"
		}
	},
	"dependencies": {
		"@bufbuild/buf": "1.60.0",
		"@bufbuild/protobuf": "2.10.1",
		"@bufbuild/protoc-gen-es": "2.10.1",
		"@connectrpc/connect": "2.1.1",
		"@connectrpc/connect-node": "2.1.1",
		"@connectrpc/connect-web": "2.1.1",
		"@noble/curves": "2.0.1",
		"@noble/hashes": "2.0.1",
		"@scure/base": "2.0.0",
		"@scure/bip32": "2.0.1",
		"@scure/bip39": "2.0.1"
	},
	"description": "JS-based standard library for Juno's Protobuffers",
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@commitlint/cli": "20.1.0",
		"@commitlint/config-conventional": "20.0.0",
		"@types/bun": "1.3.3",
		"@types/node": "24.0.1",
		"commitizen": "4.3.1",
		"cz-conventional-changelog": "3.3.0",
		"husky": "9.1.7",
		"lint-staged": "16.2.7",
		"rimraf": "6.1.2",
		"rolldown": "1.0.0-beta.51",
		"typescript": "5.9.3"
	},
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist",
		"gen"
	],
	"homepage": "https://junonetwork.io",
	"keywords": [],
	"license": "SEE LICENSE IN LICENSE",
	"name": "@buildonjuno/pioneer",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CosmosContracts/pioneer.git"
	},
	"scripts": {
		"clean": "rimraf dist && rimraf gen",
		"generate": "bun ./scripts/gen.ts",
		"build": "rolldown -c rolldown.config.ts && tsc -p tsconfig.types.json",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"lint:unsafe": "biome check --fix --unsafe",
		"typecheck": "tsc --noEmit",
		"buidl": "bun run clean && bun run generate && bun run lint:unsafe && bun run build",
		"prepare": "mise install && husky"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@bufbuild/buf"
	],
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	}
}
