{
  "author": "Marius Modlich <m.modlich@digitalkitchen.io>",
  "bugs": {
    "url": "https://github.com/CosmosContracts/pioneer/issues"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "dependencies": {
    "@bufbuild/buf": "1.54.0",
    "@bufbuild/protobuf": "2.5.2",
    "@bufbuild/protoc-gen-es": "2.5.2",
    "@connectrpc/connect": "2.0.2",
    "@connectrpc/connect-node": "2.0.2",
    "@connectrpc/connect-web": "^2.0.2",
    "@cosmjs/amino": "0.33.1",
    "@cosmjs/cosmwasm-stargate": "0.33.1",
    "@cosmjs/encoding": "0.33.1",
    "@cosmjs/proto-signing": "0.33.1",
    "@cosmjs/stargate": "0.33.1",
    "@interchainjs/cosmos": "1.11.15",
    "@interchainjs/crypto": "1.11.15",
    "@interchainjs/pubkey": "1.11.15",
    "@interchainjs/utils": "1.11.15"
  },
  "description": "JS-based standard library for Juno's Protobuffers",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/bun": "1.2.16",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.0",
    "rolldown": "1.0.0-beta.15",
    "rolldown-plugin-dts": "0.13.11",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "directories": {
    "lib": "src"
  },
  "files": ["types", "dist"],
  "homepage": "https://junonetwork.io",
  "keywords": [],
  "license": "SEE LICENSE IN LICENSE",
  "main": "main/index.js",
  "name": "@buildonjuno/pioneer",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CosmosContracts/junojs.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:types": "tsc -p tsconfig.declarations.json",
    "build:rollup": "rollup -c --configPlugin typescript",
    "test-gen": "bun ./scripts/test-gen.ts",
    "test-grpc": "bun --esm ./scripts/test-grpc.ts",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "buidl": "generate && bun run build && bun lint",
    "prepare": "mise install && husky"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@bufbuild/buf",
    "@cosmology/protobufjs",
    "core-js",
    "core-js-pure",
    "es5-ext",
    "protobufjs"
  ],
  "typings": "types/index.d.ts",
  "version": "28.0.2-beta.0",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "@bufbuild/buf"]
  }
}
